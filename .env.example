# Required: Portkey API Key (get from https://app.portkey.ai/settings/api-keys)
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional: Portkey Admin API base URL (default: https://api.portkey.ai/v1)
# Prisma AIRS and Strata Cloud Manager URLs are not compatible replacements.
# HTTPS is required unless PORTKEY_ALLOW_INSECURE_HTTP=true is explicitly set.
# Literal private/loopback hosts also require PORTKEY_ALLOW_PRIVATE_BASE_URL=true.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_ALLOW_PRIVATE_BASE_URL=true
# PORTKEY_ALLOW_INSECURE_HTTP=true

# Optional: Comma-separated tool domains to expose in stdio/HTTP sessions.
# Valid values: users, workspaces, configs, deployments, keys, collections,
# prompts, analytics, guardrails, limits, audit, labels, partials, tracing,
# logging, providers, secret-references, integrations, mcp-integrations, mcp-servers
# This is a server-side allowlist. HTTP ?tools= may narrow it, never expand it.
# Example: PORTKEY_TOOL_DOMAINS=prompts,analytics
# PORTKEY_TOOL_DOMAINS=

# Optional: Transport mode (stdio or http, default: stdio)
# MCP_TRANSPORT=stdio

# Optional: Session mode for HTTP transport
# - stateful (default): per-session in-memory transport, requires sticky routing/single instance
# - stateless: no session IDs, better for autoscaling/serverless platforms
# MCP_SESSION_MODE=stateful

# Optional: Stream resumability event store
# - off (default in all session modes)
# - memory (single-instance retention, including stateless GET replay)
# - redis (shared resumability across instances)
# MCP_EVENT_STORE=off

# Optional: Event retention TTL in seconds (default: 300)
# MCP_EVENT_TTL_SECONDS=300

# Optional in-memory replay caps (defaults: 10000 events and 67108864 bytes).
# Oldest events are evicted first when either cap is reached.
# MCP_EVENT_STORE_MAX_EVENTS=10000
# MCP_EVENT_STORE_MAX_BYTES=67108864

# Optional event-store command timeout in milliseconds (default: 5000).
# Set to 0 only to disable the timeout.
# MCP_EVENT_STORE_COMMAND_TIMEOUT_MS=5000

# Optional: Redis URL for MCP_EVENT_STORE=redis (MCP_REDIS_URL takes precedence over REDIS_URL)
# Production requires rediss://. Use Redis ACL credentials scoped to this namespace.
# MCP_REDIS_URL=rediss://username:password@redis.example.com:6379
# REDIS_URL=rediss://username:password@redis.example.com:6379

# Required when MCP_EVENT_STORE=redis: base64-encoded 32-byte AES key.
# Generate with: openssl rand -base64 32
# Rotation invalidates only unexpired replay data (five minutes by default).
# MCP_EVENT_ENCRYPTION_KEY=

# Optional: Redis key prefix for event store keys (default: mcp:event-store)
# MCP_REDIS_KEY_PREFIX=mcp:event-store

# Optional: HTTP server port (default: 3000, only used when MCP_TRANSPORT=http)
# MCP_PORT=3000

# Optional: HTTP server host (default: 127.0.0.1, only used when MCP_TRANSPORT=http)
# Set to 0.0.0.0 only when you need connections from outside localhost (Docker, reverse proxy).
# MCP_HOST=127.0.0.1

# Optional: Express trust proxy setting (default: loopback)
# Use the exact proxy hop count or a trusted subnet. The value "true" is rejected
# because it trusts forwarding headers from every peer.
# MCP_TRUST_PROXY=1

# Optional: Native HTTPS (in-app TLS).
# For cloud hosting, you can usually leave these unset and terminate HTTPS at your platform/proxy.
# MCP_TLS_KEY_PATH=/absolute/path/to/tls.key
# MCP_TLS_CERT_PATH=/absolute/path/to/tls.crt
# MCP_TLS_CA_PATH=/absolute/path/to/ca.pem

# Optional: Session timeout in milliseconds (default: 3600000 = 1 hour)
# MCP_SESSION_TIMEOUT=3600000

# Optional: Allowed origins for CORS + origin validation (comma-separated)
# Use "*" only for development.
# ALLOWED_ORIGINS=http://localhost,https://localhost

# Optional legacy alias for allowed origins (used if ALLOWED_ORIGINS is not set)
# CORS_ORIGIN=http://localhost,https://localhost

# Optional: Request body size limit (default: 1mb)
# MCP_MAX_REQUEST_SIZE=1mb

# Optional: Readiness mode
# - local: process/session readiness only
# - portkey: includes Portkey API ping via /configs
# MCP_READY_CHECK_MODE=local

# Optional: HTTP auth mode for /mcp endpoint
# - none: no auth (default, local development only; NEVER use in production/public deployments)
#   Risk: unauthenticated access to /mcp
# - bearer: static shared bearer token
# - clerk: verify Clerk JWT via JWKS
# MCP_AUTH_MODE=none

# Optional: Shared bearer token when MCP_AUTH_MODE=bearer
# MCP_AUTH_TOKEN=replace_with_long_random_secret

# Optional: Clerk JWT verification settings when MCP_AUTH_MODE=clerk
# Required: CLERK_ISSUER, CLERK_AUDIENCE, and at least one authorization policy below.
# Every configured authorization constraint must match the verified JWT.
# Optional override: CLERK_JWKS_URL (auto-derived from CLERK_ISSUER if omitted)
# CLERK_ISSUER=https://your-clerk-domain
# CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
# CLERK_AUDIENCE=your-audience
# CLERK_ALLOWED_SUBJECTS=user_admin,user_service_account
# CLERK_ALLOWED_ORGANIZATION_IDS=org_admins
# CLERK_ALLOWED_ROLES=org:admin
# CLERK_REQUIRED_PERMISSIONS=org:sys_memberships:manage

# Optional: Enable/disable rate limiting for HTTP mode (default: true)
# RATE_LIMIT_ENABLED=true

# Rate-limit store: memory (default) or redis.
# Production memory mode requires RATE_LIMIT_SINGLE_PROCESS=true.
# Multi-instance/serverless production must use redis.
# RATE_LIMIT_STORE=redis
# RATE_LIMIT_SINGLE_PROCESS=true

# Optional Redis URL/prefix for RATE_LIMIT_STORE=redis. URL falls back to
# MCP_REDIS_URL then REDIS_URL; production requires rediss://.
# RATE_LIMIT_REDIS_URL=rediss://username:password@redis.example.com:6379
# RATE_LIMIT_REDIS_KEY_PREFIX=mcp:rate-limit

# Optional: Max tokens in each pre-authentication IP and principal-plus-IP
# bucket (default: 60)
# RATE_LIMIT_MAX=60

# Optional: Rate limit window in milliseconds (default: 60000 = 1 minute)
# RATE_LIMIT_WINDOW_MS=60000

# Optional: Tokens refilled each window (default: 60)
# RATE_LIMIT_REFILL=60

# Optional: Maximum distinct in-memory rate-limit buckets (default: 10000; memory mode only)
# New clients beyond this limit share an overflow bucket.
# RATE_LIMIT_MAX_BUCKETS=10000

# Optional: Public base URL for advertised MCP endpoints (e.g., /auth/info, status page).
# Recommended for hosted deployments so URLs don't depend on request Host headers.
# MCP_PUBLIC_BASE_URL=https://mcp.example.com

# Optional: Maximum concurrent stateful MCP sessions (default: 100)
# MCP_MAX_SESSIONS=100

# Optional: Allow HTTP transport without authentication (default: not set / blocked).
# ONLY set to "true" for deliberate local-only unauthenticated HTTP debugging.
# NEVER set this in production or publicly accessible deployments.
# MCP_ALLOW_UNAUTHENTICATED_HTTP=true

# Optional: Graceful shutdown timeout in milliseconds (default: 10000)
# MCP_SHUTDOWN_TIMEOUT_MS=10000
