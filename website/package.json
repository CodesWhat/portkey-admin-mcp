{
  "name": "portkey-admin-mcp-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "fumadocs-mdx && next build",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "sync:manual": "node scripts/sync-manual.mjs",
    "check:manual": "node scripts/sync-manual.mjs --check",
    "check:export": "node scripts/check-export.mjs",
    "preview": "node scripts/preview.mjs",
    "verify": "node scripts/verify.mjs",
    "check:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "next-themes": "0.4.6"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/mdx": "2.0.14",
    "playwright-core": "1.64.1"
  }
}
